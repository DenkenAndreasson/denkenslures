{
    "builds": [
        { "src": "backend/api/index.ts", "use": "@vercel/node" },
        { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
    ],
    "routes": [
        { "src": "/api/(.*)", "dest": "backend/api/index.ts" },
        { "src": "/(.*\\.[a-zA-Z0-9]+)$", "dest": "frontend/$1" },
        { "src": "/(.*)", "dest": "frontend/index.html" }
    ]
}
